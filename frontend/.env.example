# DabbaIQ Frontend Environment Variables Template
# Copy this file to frontend/.env.local and configure your environment settings.

# Backend API base URL (must include /api suffix)
# In development: http://127.0.0.1:8000/api
# In production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
