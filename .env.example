# DabbaIQ Environment Configuration
# Copy this file to .env and fill in your values.

# ─── MongoDB Atlas ───────────────────────────────────────
# Get your connection string from MongoDB Atlas:
# https://cloud.mongodb.com → Connect → Drivers → Python
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=dabbaiq

# ─── Ollama (AI) ─────────────────────────────────────────
# Local Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Gemma model to use (pull first: ollama pull gemma3:4b)
OLLAMA_MODEL=gemma3:4b
# Request timeout in seconds
OLLAMA_TIMEOUT=120

# ─── CORS ────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Business Defaults ───────────────────────────────────
DEFAULT_SAFETY_BUFFER=0.15
