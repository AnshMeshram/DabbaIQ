# DabbaIQ Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your actual settings.
# NEVER commit your actual .env file or credentials to Git.

# ─── Application Environment ──────────────────────────────
APP_ENV=development
DEBUG=true

# ─── MongoDB Atlas Storage ────────────────────────────────
# Get your connection string from MongoDB Atlas: https://cloud.mongodb.com
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=dabbaiq
# ─── SerpAPI Real-Time Supplier Price Search ───────────────
# Get your API key from https://serpapi.com
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_LOCATION=India
SERPAPI_GL=in
SERPAPI_HL=en

# ─── Tiger Data (TimescaleDB / PostgreSQL) ────────────────
# Time-series hypertable for append-only ingredient-price snapshots
# Example: postgresql://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TIGER_DATA_DATABASE_URL=

# ─── Temporal Workflow Orchestration ──────────────────────
# Temporal dev server or cluster address
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=dabbaiq-planning-tasks

# ─── Open-Weight AI (Ollama / Gemma) ─────────────────────
# Provider type: ollama
AI_PROVIDER=ollama
# URL of local or remote Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Configured model (e.g. gemma3:4b, gemma2:2b)
OLLAMA_MODEL=gemma3:4b
# Request timeout in seconds
OLLAMA_TIMEOUT=120

# ─── Optional Partner Integrations ────────────────────────
# ElevenLabs API Key for Speech-to-Text kitchen note audio transcription
# Get your key from: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Backboard API Key for persistent assistant threads (optional)
BACKBOARD_API_KEY=

# Tinker API Key for fine-tuning kitchen models (optional)
TINKER_API_KEY=

# ─── CORS & Network Security ──────────────────────────────
# Allowed origins for frontend requests (comma-separated or single URL, NO trailing slashes)
FRONTEND_ORIGIN=https://dabba-iq.vercel.app
CORS_ORIGINS=https://dabba-iq.vercel.app,http://localhost:3000,http://127.0.0.1:3000
